# Frontend build-time variables
# Vite reads frontend/.env* for `pnpm dev` and `pnpm build`, not the repository-root .env.
# Copy this file to frontend/.env (gitignored) to override these values.

# Brand
# Blank values use the RafaCena defaults. The name affects the browser title,
# login, project lobby, and messages using the [[brand]] placeholder.
# A custom name is displayed alongside the RafaCena symbol.
# VITE_BRAND_NAME=RafaCena
# VITE_BRAND_TAGLINE=Agent-powered AI video creation workspace
# VITE_BRAND_DESCRIPTION=An AI video creation workspace for projects, scripts, storyboards, video generation and Agent conversations.
